---
import { NAV, SITE } from '../data/facility';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__name">{SITE.name}</span>
      <span class="site-header__tagline">{SITE.tagline}</span>
    </a>

    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">メニューを開く</span>
      <span aria-hidden="true">☰</span>
    </button>

    <nav id="site-nav" class="site-header__nav" aria-label="メインメニュー">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
            赤色ナイトモード
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });

  // 赤色ナイトモード: 観望中にスマホを見ても暗順応を妨げにくい配色に切り替える
  const KEY = 'nichihara-theme';
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const apply = (red: boolean) => {
    if (red) root.dataset.theme = 'red';
    else delete root.dataset.theme;
    themeButton?.setAttribute('aria-pressed', String(red));
  };
  // 初期適用は BaseLayout の inline script。ここではボタン状態だけ合わせる
  apply(root.dataset.theme === 'red');
  themeButton?.addEventListener('click', () => {
    const red = root.dataset.theme !== 'red';
    apply(red);
    try {
      localStorage.setItem(KEY, red ? 'red' : 'default');
    } catch {
      /* noop */
    }
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
    flex-wrap: wrap;
  }
  .site-header__brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1.3;
  }
  .site-header__name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .site-header__tagline {
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .site-header__toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: 8px;
    min-width: 44px;
    min-height: 44px;
    font-size: 1.25rem;
  }
  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-block;
    padding-block: var(--space-2);
  }
  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }
  .theme-toggle {
    background: none;
    border: 1px solid #a33;
    color: #ff8a8a;
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-size: 0.8rem;
    min-height: 36px;
    cursor: pointer;
  }
  .theme-toggle[aria-pressed='true'] {
    background: #3a0000;
  }

  @media (max-width: 860px) {
    .site-header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .site-header__nav {
      display: none;
      width: 100%;
      padding-bottom: var(--space-4);
    }
    .site-header__nav.is-open {
      display: block;
    }
    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    .site-header__nav a {
      padding-block: var(--space-3);
      width: 100%;
    }
  }
</style>
