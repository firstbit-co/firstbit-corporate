---
/**
 * 写真が揃うまでのヒーロー背景。ビルド時に星をランダム配置した SVG を生成する(外部画像なし)。
 * 施設の写真(75cm望遠鏡・ドーム・夜景)を入手したら public/images/ に置き、Hero 側で差し替える。
 */
interface Props {
  count?: number;
  seed?: number;
}
const { count = 180, seed = 1985 } = Astro.props;

// 再現性のある疑似乱数(ビルドごとに星の配置が変わらないように)
let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;

const stars = Array.from({ length: count }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 100).toFixed(2),
  r: (rand() * 1.1 + 0.2).toFixed(2),
  o: (rand() * 0.6 + 0.3).toFixed(2),
}));
---

<svg class="starfield" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 100 100">
  {stars.map((st) => <circle cx={st.x} cy={st.y} r={Number(st.r) / 6} fill="#fff" opacity={st.o} />)}
</svg>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 120%, #23305c 0%, var(--color-bg) 60%);
    z-index: -1;
  }
</style>
