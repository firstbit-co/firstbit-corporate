---
import BaseLayout from '../layouts/BaseLayout.astro';
import Verify from '../components/Verify.astro';
import { HISTORY, RECEPTION, TELESCOPE } from '../data/facility';

// 本番では施設に確認済みの項目だけ載せる。開発サーバーでは未確認も「要確認」付きで見える
const history = HISTORY.filter((h) => import.meta.env.DEV || h.text.verified);
---

<BaseLayout title="施設の案内" description="日原天文台、星と森の科学館、天文資料館(ポランの広場)の案内です。">
  <header class="page-header">
    <div class="container">
      <h1>施設の案内</h1>
      <p>同じ敷地に、天文台、星と森の科学館、{RECEPTION.place}（{RECEPTION.placeAlias}）があります。</p>
    </div>
  </header>

  <div class="container prose">
    <section id="observatory">
      <h2>天文台</h2>
      <!-- TODO(写真): ドームと主望遠鏡の写真を public/images/ に置いて表示 -->
      <p>主望遠鏡の口径は{TELESCOPE.aperture}です。夜は、スタッフが望遠鏡を向け、来館者がのぞきます。どの星が見えるかは、季節と月と雲で変わります。</p>
      <p>昼は、建物の中を歩きます。晴れていて太陽が高い時間には、太陽を見ることがあります。</p>
      <p><a href="/about/#telescope">75cm望遠鏡のくわしい仕様</a></p>
    </section>

    <section id="museum">
      <h2>星と森の科学館</h2>
      <p>入場券は{RECEPTION.place}で買います。</p>
      <!-- TODO(取材): 展示の内容と見学の目安時間 -->
    </section>

    <section id="archive">
      <h2>{RECEPTION.place}（{RECEPTION.placeAlias}）</h2>
      <p>受付があります。来館したら、まずここで受付をします。</p>
      <!-- TODO(取材): 資料館で見られるもの -->
    </section>

    <section id="history">
      <h2>あゆみ</h2>
      <ol class="timeline">
        {history.map((h) => <li><span class="timeline__year">{h.year}</span><Verify fact={h.text} /></li>)}
      </ol>
      <p><a href="/about/#history">日原天文台の歴史</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }
  .timeline li {
    padding: 0 0 var(--space-4) var(--space-6);
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.55em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .timeline__year {
    display: block;
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
