---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT, HOURS, SITE, range } from '../../data/facility';

// TODO(Phase 3): 英語版の拡充。料金・時間は facility.ts から読み、翻訳はネイティブチェックを通す
---

<BaseLayout
  lang="en"
  title={SITE.nameEn}
  description="Nichihara Observatory on Mt. Makurase in Tsuwano, Shimane. Opened in 1985, with a 75cm telescope."
>
  <header class="page-header">
    <div class="container">
      <h1>{SITE.nameEn}</h1>
      <p>Japan's first public observatory — Tsuwano, Shimane</p>
    </div>
  </header>
  <div class="container prose">
    <p>
      Nichihara Observatory opened in 1985 on Mt. Makurase in Tsuwano. At night, our staff point the 75cm telescope and
      visitors look through it. What you can see depends on the season, the Moon and the clouds.
    </p>
    <h2>Hours</h2>
    <ul>
      <li>Daytime visit: {range(HOURS.day.start, HOURS.day.end)}</li>
      <li>Night observation: {range(HOURS.night.start, HOURS.night.end)} (from {HOURS.night.summerStart} in summer)</li>
      <li>Closed: every Tuesday and Wednesday, and January 1</li>
      <li>No reservations. Please check in at the Astronomical Archive (Polan no Hiroba) on the day.</li>
    </ul>
    <h2>Access</h2>
    <p>About 5–15 minutes by taxi from JR Nichihara Station (Yamaguchi Line).</p>
    <p>Address: 806-1 Makurase, Tsuwano-cho, Kanoashi-gun, Shimane, Japan</p>
    <p>Tel: +81-856-74-1646 ({CONTACT.tel.value})</p>
    <p><a href="/" lang="ja">日本語サイトへ</a></p>
  </div>
</BaseLayout>
