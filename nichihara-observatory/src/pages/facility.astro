---
import BaseLayout from '../layouts/BaseLayout.astro';
import Verify from '../components/Verify.astro';
import { HISTORY, TELESCOPE } from '../data/facility';
---

<BaseLayout title="施設紹介" description="日原天文台の75cm反射望遠鏡、星と森の科学館、天文資料館、願い星★宅配便のご紹介。">
  <header class="page-header">
    <div class="container">
      <h1>施設紹介</h1>
      <p>日本初の公開天文台と、宇宙と地球環境を学べる科学館。</p>
    </div>
  </header>

  <div class="container prose">
    <section id="telescope">
      <h2>75cm反射望遠鏡</h2>
      <!-- TODO(写真): ドーム内の望遠鏡の写真を public/images/telescope.jpg に置いて表示 -->
      <table class="table">
        <tbody>
          <tr><th scope="row">口径</th><td><Verify fact={TELESCOPE.aperture} /></td></tr>
          <tr><th scope="row">形式</th><td><Verify fact={TELESCOPE.type} /></td></tr>
        </tbody>
      </table>
      <p><Verify fact={TELESCOPE.story} /></p>
      <p>
        ナスミス焦点は、望遠鏡がどの方向を向いても接眼部(のぞく場所)の位置が変わりにくく、子どもから大人まで同じ姿勢で観望できるのが特長です。
      </p>
    </section>

    <section id="museum">
      <h2>星と森の科学館</h2>
      <p>
        天文学と森林を中心とした地球環境をテーマに、映像や立体展示でわかりやすく紹介する科学館です。地球とほかの天体での重力の違いを体験できるコーナーもあります。
      </p>
      <!-- TODO(取材): 展示の一覧・写真・所要時間を施設に確認して追加 -->
    </section>

    <section id="archive">
      <h2>天文資料館</h2>
      <p class="muted">展示内容は現在確認中です。</p>
    </section>

    <section id="wish">
      <h2>願い星★宅配便</h2>
      <p>天文台の階段横のポストに願いごとを投函できます。</p>
      <!-- TODO(取材): 投函用紙の入手方法、その後どうなるのか(星に届ける演出の内容)を確認 -->
    </section>

    <section id="history">
      <h2>あゆみ</h2>
      <ol class="timeline">
        {HISTORY.map((h) => <li><span class="timeline__year">{h.year}</span><Verify fact={h.text} /></li>)}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }
  .timeline li {
    padding: 0 0 var(--space-4) var(--space-6);
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.55em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .timeline__year {
    display: block;
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
